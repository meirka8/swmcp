<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Development feed for SwBridge before it is published to nuget.org.
         Populate with: dotnet pack ../swbridge/src/SwBridge/SwBridge.csproj -c Release -o ../localnuget -->
    <add key="workspace-local" value="..\localnuget" />
  </packageSources>
</configuration>
